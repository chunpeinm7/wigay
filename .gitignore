# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml
__pycache__/
*.pyc

# Gesture Lab (LSTM 手勢辨識後端)
gesture-lab/node_modules/
gesture-lab/.env
gesture-lab/.env.local
gesture-lab/data/*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
